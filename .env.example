BASE_URL=http://localhost/dev/website/
APP_DEBUG=0
APP_NAME=Next Demo

CONTACT_EMAIL=hello@example.com
MAIL_API_URL=https://example.com/mailer/send.php
MAIL_API_KEY=
MAIL_TO=
MAIL_FROM_EMAIL=noreply@example.com
MAIL_BCC=

# Theme file from assets/theme/ without the "theme-" prefix and ".css" (e.g. claude, vercel, supabase)
THEME=claude

# SEO: social preview image (1200x630, relative to BASE_URL), comma-separated profile URLs, optional X/Twitter handle
OG_IMAGE=assets/images/og-image.png
SOCIAL_LINKS=
TWITTER_HANDLE=

# Brand colours: browser theme-color, web manifest and the contact email header
THEME_COLOR=#c96442
BACKGROUND_COLOR=#faf9f5
BACKGROUND_COLOR_DARK=#2b2a27
